# Backend — copy to .env for local dev ONLY. Never commit .env.
# All production values live in Railway environment variables.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/staynaivasha
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-strong-random-secret

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.avistay.com/api/payments/mpesa/callback
# Required when M-Pesa is enabled. Appended to every callback URL; Safaricom
# does not sign callbacks, so this is what authenticates them. >= 32 chars:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_SECRET=

# Card payments (Paystack). Card checkout stays hidden until this is set.
# Test key sk_test_... works end to end. Webhook URL to set in the Paystack
# dashboard: https://api.avistay.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# B2C (payouts/refunds): API operator username from the M-Pesa org portal — NOT the shortcode
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# https://sandbox.safaricom.co.ke for sandbox testing
MPESA_BASE_URL=https://api.safaricom.co.ke

AT_API_KEY=
AT_USERNAME=sandbox

# Claude (guest AI assistant + host description writer). Get a key at console.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
SENDGRID_API_KEY=
FCM_SERVER_KEY=
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

SENTRY_DSN=

# Frontend (Vite) — prefix with VITE_ to expose to browser
# Generate VAPID key pair once with: npx web-push generate-vapid-keys
# Set VITE_VAPID_PUBLIC_KEY in frontend env, VAPID_PRIVATE_KEY in backend env
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@avistay.com

# Cloudinary (frontend)
# Dev-only fallback. In production uploads are signed by the backend using
# CLOUDINARY_URL — leave these empty and DELETE the unsigned preset in the
# Cloudinary console, or anyone can upload to your account.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# Google sign-in (optional; the button stays hidden until these are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI:  https://avistay.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The website's own address, NOT api.avistay.com: the site reaches the API through
# avistay.com/api, so the sign-in cookies must be set on avistay.com.
BACKEND_URL=https://avistay.com
FRONTEND_URL=https://avistay.com

